# Netrunner theme (Cyberpunk 2077 breach protocol), matching i3, rofi and kitty.
# Layout lives here. Colours, formats and the per-app rules (volume, brightness,
# pacman, kill mode) are rendered by netrunner-theme into dunstrc.d/50-netrunner.conf.

[global]
    font = Iosevka Nerd Font 11
    origin = top-right
    offset = (14, 14)
    width = (280, 360)
    padding = 10
    horizontal_padding = 14
    text_icon_padding = 12
    gap_size = 8
    frame_width = 1
    corner_radius = 0
    separator_color = frame
    progress_bar_height = 6
    progress_bar_frame_width = 1
    progress_bar_corner_radius = 0
    progress_bar_min_width = 250
    progress_bar_max_width = 330
    icon_position = left
    min_icon_size = 0
    max_icon_size = 40
    markup = full
    alignment = left
    ellipsize = end
    show_age_threshold = 60
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    timeout = 5

[urgency_normal]
    timeout = 8

[urgency_critical]
    timeout = 0
