# i3blocks config file
# Netrunner theme: dim olive tags, acid-yellow readouts, cyan clock.
# Separators come from i3bar's separator_symbol in ~/.config/i3/config.
separator=true
separator_block_width=15
markup=pango
color=#D0ED57

[spotify]
label=<span foreground='#6B7A2E'>󰓇 AUDIO </span>
command=$HOME/.config/i3/script/spotify.sh
interval=5

[wifi]
label=<span foreground='#6B7A2E'>󰖩 NET </span>
command=nmcli -t -f active,ssid dev wifi | grep '^yes' | cut -d: -f2 | sed 's/&/\&amp;/g; s/</\&lt;/g'
interval=10

[ip]
label=<span foreground='#6B7A2E'>󰩠 IP </span>
command=ip addr | grep -E 'inet\s' | grep -v '127.0.0.1' | awk '{print $2}' | cut -d/ -f1 | head -n1
interval=10

[battery]
label=<span foreground='#6B7A2E'>PWR </span>
# Icon reflects actual charge level (battery.sh picks the matching Nerd Font glyph)
command=$HOME/.config/i3/script/battery.sh
interval=30

[disk]
label=<span foreground='#6B7A2E'>󰋊 DSK </span>
command=df -h / | awk '/\// {print $4}'
interval=30

[memory]
label=<span foreground='#6B7A2E'>󰍛 MEM </span>
command=free -h | awk '/Mem:/ {print $3}'
interval=10

[time]
label=<span foreground='#6B7A2E'>󰅐 </span>
command=date '+%Y.%m.%d <span foreground="#6B7A2E">//</span> %I:%M %p'
interval=5
color=#5EF6FF
