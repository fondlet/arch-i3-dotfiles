general {
    colors = true
    interval = 5
    output_format = "i3bar"
}

# Only the things you actually want to see:
order += "wireless _first_"
order += "battery all"
order += "disk /"
order += "memory"
order += "tztime local"

wireless _first_ {
    format_up = "󰖩 %quality %ip"
    format_down = "󰖪 down"
}

disk "/" {
    format = "󰋊 %avail"
}

memory {
    format = "󰍛 %used"
    threshold_degraded = "1G"
    format_degraded = "MEMORY < %available"
}

tztime local {
    format = "󰃭 %Y-%m-%d 󰅐 %I:%M %p"
}

battery all {
    format = "%status %percentage"
    format_down = "󰂑"
    status_chr = "󰂄⚡"
    status_bat = "󰁹"
    status_unk = "󰂑"
    status_full = "󰁹"
    low_threshold = 15
    threshold_type = percentage
}
