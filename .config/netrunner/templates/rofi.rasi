// Generated by netrunner-theme from the @NR_THEME@ palette.
* {
    bg:          @NR_BG@;
    bg-panel:    @NR_BG_PANEL@;
    bg-row:      @NR_BG_ROW@;
    accent:      @NR_ACCENT@;
    accent-dim:  @NR_ACCENT_DIM@;
    accent-dark: @NR_ACCENT_DARK@;
    hi:          @NR_HI@;
    alert:       @NR_ALERT@;
}

// rofi does not resolve variables inside highlight, so the colour is written out
element-text {
    highlight: bold @NR_HI@;
}
