// Netrunner theme: Cyberpunk 2077 breach-protocol look, shared with i3,
// i3blocks, dunst, kitty and the lock screen. The colours (@bg, @accent, @hi...)
// come from the active palette, imported at the bottom.

configuration {
    modes: "drun,run,window";
    font: "Iosevka Nerd Font 12";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    drun-display-format: "{name}";
    display-drun: "APPS";
    display-run: "RUN";
    display-window: "WINDOWS";
}

* {
    transparent: #00000000;

    background-color: @transparent;
    text-color:       @accent;
}

window {
    background-color: @bg;
    border:           1px;
    border-color:     @accent;
    border-radius:    0;
    width:            620px;
    padding:          0;
}

mainbox {
    children: [header, body, footer];
    spacing:  0;
}

// Solid accent strip, like the CODE MATRIX / SEQUENCE panel titles
header {
    orientation:      horizontal;
    children:         [textbox-title, textbox-tag];
    background-color: @accent;
    padding:          6px 14px;
    expand:           false;
}

textbox-title {
    content:    "//  APP MANAGER";
    font:       "Iosevka Nerd Font Bold 12";
    text-color: @bg;
    expand:     true;
}

textbox-tag {
    content:        "NET_ARCH :: MORIKAI";
    font:           "Iosevka Nerd Font 9";
    text-color:     @bg;
    expand:         false;
    vertical-align: 0.5;
}

body {
    orientation: vertical;
    children:    [inputbar, mode-switcher, listview];
    padding:     14px;
    spacing:     12px;
}

inputbar {
    children:         [prompt, textbox-sep, entry, num-filtered-rows];
    background-color: @bg-panel;
    border:           1px;
    border-color:     @accent-dim;
    padding:          8px 12px;
    spacing:          10px;
}

prompt {
    font:       "Iosevka Nerd Font Bold 12";
    text-color: @accent;
}

textbox-sep {
    expand:     false;
    content:    "▸";
    text-color: @accent-dim;
}

entry {
    text-color:        @accent;
    cursor-color:      @hi;
    cursor-width:      8px;
    placeholder:       "ENTER SEQUENCE...";
    placeholder-color: @accent-dim;
}

num-filtered-rows {
    text-color: @accent-dim;
    font:       "Iosevka Nerd Font 10";
}

mode-switcher {
    spacing: 8px;
}

button {
    padding:      3px 10px;
    border:       1px;
    border-color: @accent-dark;
    text-color:   @accent-dim;
    font:         "Iosevka Nerd Font 10";
}

button selected {
    background-color: @accent-dark;
    border-color:     @accent;
    text-color:       @accent;
}

listview {
    lines:        9;
    columns:      1;
    spacing:      2px;
    scrollbar:    true;
    fixed-height: true;
    border:       1px 0 0 0;
    border-color: @accent-dark;
    padding:      8px 0 0 0;
}

element {
    padding:      7px 12px;
    spacing:      12px;
    border:       0 0 0 3px;
    border-color: @transparent;
    text-color:   @accent;
}

element normal.normal,
element alternate.normal {
    background-color: @transparent;
    text-color:       @accent;
}

// Selected row: the grey-blue band from the code matrix, with an accent tick
element selected.normal {
    background-color: @bg-row;
    border-color:     @accent;
    text-color:       @accent;
}

element normal.active,
element alternate.active {
    text-color: @hi;
}

element selected.active {
    background-color: @bg-row;
    border-color:     @hi;
    text-color:       @hi;
}

element normal.urgent,
element alternate.urgent,
element selected.urgent {
    text-color: @alert;
}

element-icon {
    size: 22px;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
}

scrollbar {
    handle-color:     @accent;
    handle-width:     3px;
    background-color: @accent-dark;
}

footer {
    orientation:  horizontal;
    children:     [textbox-nav, textbox-run, textbox-mode, textbox-close];
    border:       1px 0 0 0;
    border-color: @accent-dark;
    padding:      7px 14px;
    spacing:      18px;
    expand:       false;
}

textbox-nav, textbox-run, textbox-mode, textbox-close {
    font:       "Iosevka Nerd Font 9";
    text-color: @accent-dim;
    expand:     false;
}

textbox-nav   { content: "[↑↓] NAVIGATE"; }
textbox-run   { content: "[⏎] EXECUTE"; }
textbox-mode  { content: "[CTRL+TAB] MODE"; }
textbox-close { content: "[ESC] CLOSE"; }

@import "~/.config/netrunner/current/rofi.rasi"
